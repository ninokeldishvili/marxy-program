# Copy to .env.local and fill in. `npm run devnet:setup` prints the values it used.

# --- App (browser) ---------------------------------------------------------
# RPC the browser uses. Defaults to clusterApiUrl("devnet"). A dedicated devnet
# RPC (Helius, Triton, QuickNode...) is much smoother than the public endpoint.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Explorer cluster for links (keep "devnet").
NEXT_PUBLIC_EXPLORER_CLUSTER=devnet

# --- Server routes, worker and scripts -------------------------------------
# RPC for the faucet route, the worker and the scripts (defaults to NEXT_PUBLIC_RPC_URL).
RPC_URL=https://api.devnet.solana.com
# The program admin keypair (mint authority of the test mints). Server-side only.
ADMIN_KEYPAIR_PATH=~/.config/solana/id.json
# Shared secret for the /admin page's API routes (header x-admin-secret).
ADMIN_API_SECRET=change-me-to-a-long-random-string

# --- Program config (npm run devnet:setup) -----------------------------------
# Get-ready period for new auctions, in seconds (60-3600): sales close to battle
# start. Applied by `npm run devnet:setup` (`-- --update-config` to change it).
GET_READY_SECS=300

# --- Worker ----------------------------------------------------------------
# Sales length for demo lots, in minutes.
DEMO_SALES_MINUTES=10
# Demo bots: buy to the minimum 1 min before sales close and bid in battles.
DEMO_BOTS=true
# Number of bots and the SOL each gets from the admin.
BOT_COUNT=20
BOT_SOL=0.03

# --- Jupiter (optional) ----------------------------------------------------
# Without a key the lite endpoint (https://lite-api.jup.ag/price/v3) is used;
# with one, https://api.jup.ag/price/v3. JUP_PRICE_URL overrides both.
JUP_API_KEY=
JUP_PRICE_URL=

# --- Smoke test (optional) -------------------------------------------------
SMOKE_SALES_SECS=60
SMOKE_LOT_AMOUNT=0.05

# --- Paths (optional; defaults shown) ---------------------------------------
# MARXY_KEYS_DIR=.keys
# MARXY_STATE_PATH=worker/state.json
