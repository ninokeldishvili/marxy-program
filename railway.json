{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": ["worker/**", "packages/**", "package.json", "package-lock.json", "railway.json"]
  },
  "deploy": {
    "startCommand": "npm run worker",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1
  }
}
