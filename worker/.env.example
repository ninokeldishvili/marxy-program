# Copy to .env.local (local runs) or set as environment variables on the host
# (Railway etc.). `npm run devnet:setup` checks and prints them.

# --- Solana ----------------------------------------------------------------
# RPC for the worker and its scripts. Keep it private: it may carry an API key.
RPC_URL=https://api.devnet.solana.com
# The program admin: either the keypair's JSON byte array (hosts without files)...
# ADMIN_KEYPAIR=[12,34,...]
# ...or a keypair file (local runs).
ADMIN_KEYPAIR_PATH=~/.config/solana/id.json

# --- Admin API (api.ts) -----------------------------------------------------
# Secret the /admin page sends as x-admin-secret: openssl rand -hex 24
ADMIN_API_SECRET=change-me-to-a-long-random-string
# Frontend origins allowed to call the API from a browser (comma-separated).
ALLOWED_ORIGIN=http://localhost:3000
# Port to listen on (hosts usually set PORT themselves).
PORT=8787

# --- Program config (npm run devnet:setup) -----------------------------------
# Get-ready period for new auctions, in seconds (60-3600): sales close to battle
# start. Applied by `npm run devnet:setup` (`-- --update-config` to change it).
GET_READY_SECS=300

# --- Auctions ----------------------------------------------------------------
# Sales length for lot types without their own salesMinutes, in minutes.
SALES_MINUTES=30
# Warn in the log when the admin wallet holds less SOL than this.
LOW_SOL=1

# --- Jupiter (optional) ----------------------------------------------------
# Without a key the lite endpoint (https://lite-api.jup.ag/price/v3) is used;
# with one, https://api.jup.ag/price/v3. JUP_PRICE_URL overrides both.
JUP_API_KEY=
JUP_PRICE_URL=

# --- Paths (optional; defaults shown, relative to the worker folder) ---------
# MARXY_KEYS_DIR=.keys
# MARXY_STATE_PATH=state.json
